@model List<CMCS.Models.Claim>

<h2>Contract Monthly Claim System Dashboard</h2>

<div class="row">
    <div class="col-md-6">
        <h3>Recent Claims</h3>
        <table class="table">
            <thead>
                <tr>
                    <th>Lecturer</th>
                    <th>Hours</th>
                    <th>Rate</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var claim in Model)
                {
                    <tr>
                        <td>@claim.LecturerName</td>
                        <td>@claim.HoursWorked</td>
                        <td>@claim.HourlyRate</td>
                        <td>@claim.Status</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="col-md-6">
        <h3>Quick Actions</h3>
        <a href="@Url.Action("Submit", "Claim")" class="btn btn-primary">Submit New Claim</a>
        <a href="@Url.Action("Index", "Claim")" class="btn btn-secondary">View All Claims</a>
    </div>
</div>

@if (ViewBag.UserRole == "Lecturer")
{
    <div class="col-md-6">
        <h3>My Claims</h3>
        <!-- Display lecturer-specific information -->
    </div>
}
else if (ViewBag.UserRole == "ProgrammeCoordinator" || ViewBag.UserRole == "AcademicManager")
{
    <div class="col-md-6">
        <h3>Claims to Review</h3>
        <!-- Display claims that need review -->
    </div>
}
else if (ViewBag.UserRole == "HR")
{
    <div class="col-md-6">
        <h3>HR Overview</h3>
        <!-- Display HR-specific information -->
    </div>
}