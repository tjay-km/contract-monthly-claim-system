@model CMCS.Models.ViewModels.DashboardViewModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@using CMCS.Models.Enums
@{
    ViewData["Title"] = "Dashboard";
    var antiforgeryToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}

<div class="container mx-auto px-4 py-8">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <h1 class="text-3xl font-bold mb-8">Contract Monthly Claim System Dashboard</h1>

    @if (User.IsInRole("Lecturer"))
    {
        <div class="mb-8">
            <h2 class="text-2xl font-bold mb-4">Submit Claim</h2>
            <a href="@Url.Action("Submit", "Claim")" class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">Go to Submit Claim</a>
        </div>

        <div class="bg-white shadow-md rounded px-4 sm:px-8 pt-6 pb-8 mb-4 overflow-x-auto">
            <h2 class="text-2xl font-bold mb-4">My Claims</h2>
            <div class="hidden sm:block">
                <table class="w-full">
                    <thead>
                        <tr>
                            <th class="px-4 py-2">Submission Date</th>
                            <th class="px-4 py-2">Hours Worked</th>
                            <th class="px-4 py-2">Hourly Rate</th>
                            <th class="px-4 py-2">Total Amount</th>
                            <th class="px-4 py-2">Status</th>
                            <th class="px-4 py-2">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var claim in Model.Claims)
                        {
                            <tr>
                                <td class="border px-4 py-2">@claim.SubmissionDate.ToString("yyyy-MM-dd")</td>
                                <td class="border px-4 py-2">@claim.HoursWorked</td>
                                <td class="border px-4 py-2">@claim.HourlyRate.ToString("C")</td>
                                <td class="border px-4 py-2">@((claim.HoursWorked * claim.HourlyRate).ToString("C"))</td>
                                <td class="border px-4 py-2">
                                    @if (claim.Status == ClaimStatus.Approved || claim.Status == ClaimStatus.Rejected)
                                    {
                                        <span class="badge badge-success">@claim.Status</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-warning">@claim.Status</span>
                                    }
                                    @if (claim.Status == ClaimStatus.Rejected && !string.IsNullOrEmpty(claim.RejectionReason))
                                    {
                                        <br />
                                        <small class="text-red-500">Reason: @claim.RejectionReason</small>
                                    }
                                </td>
                                <td class="border px-4 py-2">
                                    @if (claim.SupportingDocumentPath != null)
                                    {
                                        <a href="@Url.Action("DownloadDocument", "Claim", new { id = claim.Id })" class="text-blue-500 hover:text-blue-700">Download Document</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="sm:hidden">
                @foreach (var claim in Model.Claims)
                {
                    <div class="bg-gray-100 rounded-lg p-4 mb-4">
                        <p><strong>Submission Date:</strong> @claim.SubmissionDate.ToString("yyyy-MM-dd")</p>
                        <p><strong>Hours:</strong> @claim.HoursWorked</p>
                        <p><strong>Rate:</strong> @claim.HourlyRate.ToString("C")</p>
                        <p><strong>Total:</strong> @((claim.HoursWorked * claim.HourlyRate).ToString("C"))</p>
                        <p>
                            <strong>Status:</strong>
                            @if (claim.Status == ClaimStatus.Approved || claim.Status == ClaimStatus.Rejected)
                            {
                                <span class="badge badge-success">@claim.Status</span>
                            }
                            else
                            {
                                <span class="badge badge-warning">@claim.Status</span>
                            }
                            @if (claim.Status == ClaimStatus.Rejected && !string.IsNullOrEmpty(claim.RejectionReason))
                            {
                                <br />
                                <small class="text-red-500">Reason: @claim.RejectionReason</small>
                            }
                        </p>
                        @if (claim.SupportingDocumentPath != null)
                        {
                            <a href="@Url.Action("DownloadDocument", "Claim", new { id = claim.Id })" class="text-blue-500 hover:text-blue-700">Download Document</a>
                        }
                    </div>
                }
            </div>
        </div>
    }

    @if (User.IsInRole("ProgrammeCoordinator") || User.IsInRole("AcademicManager"))
    {
        <div class="bg-white shadow-md rounded px-4 sm:px-8 pt-6 pb-8 mb-4 overflow-x-auto">
            <h2 class="text-2xl font-bold mb-4">Pending Claims</h2>
            <div class="hidden sm:block">
                <table class="w-full">
                    <thead>
                        <tr>
                            <th class="px-4 py-2">Submission Date</th>
                            <th class="px-4 py-2">Lecturer</th>
                            <th class="px-4 py-2">Hours Worked</th>
                            <th class="px-4 py-2">Hourly Rate</th>
                            <th class="px-4 py-2">Total Amount</th>
                            <th class="px-4 py-2">Notes</th>
                            <th class="px-4 py-2">Supporting Document</th>
                            <th class="px-4 py-2">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var claim in Model.PendingClaims)
                        {
                            <tr>
                                <td class="border px-4 py-2">@claim.SubmissionDate.ToString("yyyy-MM-dd")</td>
                                <td class="border px-4 py-2 break-words">@claim.LecturerName</td>
                                <td class="border px-4 py-2">@claim.HoursWorked</td>
                                <td class="border px-4 py-2">@claim.HourlyRate.ToString("C")</td>
                                <td class="border px-4 py-2">@((claim.HoursWorked * claim.HourlyRate).ToString("C"))</td>
                                <td class="border px-4 py-2 overflow-auto break-words max-w-xs">@claim.AdditionalNotes</td>
                                <td class="border px-4 py-2">
                                    @if (!string.IsNullOrEmpty(claim.SupportingDocumentPath))
                                    {
                                        <a href="@Url.Action("DownloadDocument", "Claim", new { id = claim.Id })" class="text-blue-500 hover:text-blue-700">View Document</a>
                                    }
                                </td>
                                <td class="border px-4 py-2">
                                    <button onclick="updateClaimStatus(@claim.Id, 'Approved')" class="bg-green-500 hover:bg-green-700 text-white font-bold py-1 px-2 rounded mr-2">
                                        Approve
                                    </button>
                                    <form asp-controller="Claim" asp-action="InitiateReject" method="post" class="inline">
                                        <input type="hidden" name="id" value="@claim.Id" />
                                        <button type="submit" class="bg-red-500 hover:bg-red-700 text-white font-bold py-1 px-2 rounded">
                                            Reject
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="sm:hidden">
                @foreach (var claim in Model.PendingClaims)
                {
                    <div class="bg-gray-100 rounded-lg p-4 mb-4">
                        <p><strong>Submission Date:</strong> @claim.SubmissionDate.ToString("yyyy-MM-dd")</p>
                        <p><strong>Lecturer:</strong> <span class="break-words">@claim.LecturerName</span></p>
                        <p><strong>Hours:</strong> @claim.HoursWorked</p>
                        <p><strong>Rate:</strong> @claim.HourlyRate.ToString("C")</p>
                        <p><strong>Total:</strong> @((claim.HoursWorked * claim.HourlyRate).ToString("C"))</p>
                        <p><strong>Notes:</strong> <span class="break-words">@claim.AdditionalNotes</span></p>
                        @if (!string.IsNullOrEmpty(claim.SupportingDocumentPath))
                        {
                            <a href="@Url.Action("DownloadDocument", "Claim", new { id = claim.Id })" class="text-blue-500 hover:text-blue-700">View Document</a>
                        }
                        <div class="mt-2">
                            <button onclick="updateClaimStatus(@claim.Id, 'Approved')" class="bg-green-500 hover:bg-green-700 text-white font-bold py-1 px-2 rounded mr-2">
                                Approve
                            </button>
                            <form asp-controller="Claim" asp-action="InitiateReject" method="post" class="inline">
                                <input type="hidden" name="id" value="@claim.Id" />
                                <button type="submit" class="bg-red-500 hover:bg-red-700 text-white font-bold py-1 px-2 rounded">
                                    Reject
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="bg-white shadow-md rounded px-4 sm:px-8 pt-6 pb-8 mb-4 overflow-x-auto">
            <h2 class="text-2xl font-bold mb-4">Managed Claims</h2>
            <div class="hidden sm:block">
                <table class="w-full">
                    <thead>
                        <tr>
                            <th class="px-4 py-2">Submission Date</th>
                            <th class="px-4 py-2">Lecturer</th>
                            <th class="px-4 py-2">Hours Worked</th>
                            <th class="px-4 py-2">Hourly Rate</th>
                            <th class="px-4 py-2">Total Amount</th>
                            <th class="px-4 py-2">Notes</th>
                            <th class="px-4 py-2">Supporting Document</th>
                            <th class="px-4 py-2">Status</th>
                            <th class="px-4 py-2">Rejection Reason</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var claim in Model.ManagedClaims)
                        {
                            <tr>
                                <td class="border px-4 py-2">@claim.SubmissionDate.ToString("yyyy-MM-dd")</td>
                                <td class="border px-4 py-2 break-words">@claim.LecturerName</td>
                                <td class="border px-4 py-2">@claim.HoursWorked</td>
                                <td class="border px-4 py-2">@claim.HourlyRate.ToString("C")</td>
                                <td class="border px-4 py-2">@((claim.HoursWorked * claim.HourlyRate).ToString("C"))</td>
                                <td class="border px-4 py-2 overflow-auto break-words max-w-xs">@claim.AdditionalNotes</td>
                                <td class="border px-4 py-2">
                                    @if (!string.IsNullOrEmpty(claim.SupportingDocumentPath))
                                    {
                                        <a href="@Url.Action("DownloadDocument", "Claim", new { id = claim.Id })" class="text-blue-500 hover:text-blue-700">View Document</a>
                                    }
                                </td>
                                <td class="border px-4 py-2">
                                    @if (claim.Status == ClaimStatus.Approved || claim.Status == ClaimStatus.Rejected)
                                    {
                                        <span class="badge badge-success">@claim.Status</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-warning">@claim.Status</span>
                                    }
                                    @if (claim.Status == ClaimStatus.Rejected && !string.IsNullOrEmpty(claim.RejectionReason))
                                    {
                                        <br />
                                        <small class="text-red-500">Reason: @claim.RejectionReason</small>
                                    }
                                </td>
                                <td class="border px-4 py-2 overflow-auto break-words max-w-xs">
                                    @if (claim.Status == ClaimStatus.Rejected)
                                    {
                                        <span class="text-red-500">@claim.RejectionReason</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="sm:hidden">
                @foreach (var claim in Model.ManagedClaims)
                {
                    <div class="bg-gray-100 rounded-lg p-4 mb-4">
                        <p><strong>Submission Date:</strong> @claim.SubmissionDate.ToString("yyyy-MM-dd")</p>
                        <p><strong>Lecturer:</strong> <span class="break-words">@claim.LecturerName</span></p>
                        <p><strong>Hours:</strong> @claim.HoursWorked</p>
                        <p><strong>Rate:</strong> @claim.HourlyRate.ToString("C")</p>
                        <p><strong>Total:</strong> @((claim.HoursWorked * claim.HourlyRate).ToString("C"))</p>
                        <p><strong>Notes:</strong> <span class="break-words">@claim.AdditionalNotes</span></p>
                        @if (!string.IsNullOrEmpty(claim.SupportingDocumentPath))
                        {
                            <p><a href="@Url.Action("DownloadDocument", "Claim", new { id = claim.Id })" class="text-blue-500 hover:text-blue-700">View Document</a></p>
                        }
                        <p>
                            <strong>Status:</strong>
                            @if (claim.Status == ClaimStatus.Approved || claim.Status == ClaimStatus.Rejected)
                            {
                                <span class="badge badge-success">@claim.Status</span>
                            }
                            else
                            {
                                <span class="badge badge-warning">@claim.Status</span>
                            }
                            @if (claim.Status == ClaimStatus.Rejected && !string.IsNullOrEmpty(claim.RejectionReason))
                            {
                                <br />
                                <small class="text-red-500">Reason: @claim.RejectionReason</small>
                            }
                        </p>
                        @if (claim.Status == ClaimStatus.Rejected)
                        {
                            <p>
                                <strong>Rejection Reason:</strong>
                                <span class="text-red-500">@claim.RejectionReason</span>
                            </p>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        function updateClaimStatus(id, status) {
            if (status !== 'Approved') {
                alert('Invalid operation. Rejections must go through the dedicated rejection flow.');
                return;
            }

            fetch('@Url.Action("UpdateClaimStatus", "Dashboard")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': '@antiforgeryToken'
                },
                body: `id=${id}&status=${status}`
            })
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Network response was not ok');
                    }
                    return response.json();
                })
                .then(result => {
                    if (result.success) {
                        alert(result.message);
                        location.reload();
                    } else {
                        alert('Error updating claim status: ' + result.message);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('An error occurred while updating the claim status');
                });
        }
    </script>
}