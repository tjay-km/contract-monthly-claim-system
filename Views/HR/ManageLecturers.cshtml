@model IEnumerable<ApplicationUser>
@{
    ViewData["Title"] = "Manage Lecturers";
}

<div class="container">
    <div class="card">
        <div class="card-header">
            <h4 class="mb-0">Manage Lecturers</h4>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Department</th>
                            <th>Phone</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var lecturer in Model)
                        {
                            <tr>
                                <td>@lecturer.FirstName @lecturer.LastName</td>
                                <td>@lecturer.Email</td>
                                <td>@lecturer.Department</td>
                                <td>@lecturer.PhoneNumber</td>
                                <td>
                                    <a asp-action="EditLecturer" asp-route-id="@lecturer.Id" 
                                       class="btn btn-primary btn-sm">Edit</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
