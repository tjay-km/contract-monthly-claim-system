@model AutoApprovalConfig
@{
    ViewData["Title"] = "Configure Auto-Approval";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h4 class="mb-0">Configure Auto-Approval Settings</h4>
                </div>
                <div class="card-body">
                    <form asp-action="ConfigureAutoApproval" method="post">
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-3">
                            <label asp-for="MaxAutoApprovalAmount" class="form-label">Maximum Auto-Approval Amount (R)</label>
                            <input asp-for="MaxAutoApprovalAmount" class="form-control" type="number" step="0.01" min="0" required />
                            <span asp-validation-for="MaxAutoApprovalAmount" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <div class="form-check form-switch">
                                <input asp-for="EnableAutoApproval" class="form-check-input" type="checkbox" />
                                <label asp-for="EnableAutoApproval" class="form-check-label">Enable Auto-Approval</label>
                            </div>
                            <span asp-validation-for="EnableAutoApproval" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Dashboard" class="btn btn-secondary">Back to Dashboard</a>
                            <button type="submit" class="btn btn-primary">Save Changes</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
