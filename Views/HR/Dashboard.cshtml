@using CMCS.Models.Enums
@model CMCS.Models.HRDashboardViewModel
@{
    ViewData["Title"] = "HR Dashboard";
}

<div class="container-fluid">
    <h2>HR Dashboard</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <h5 class="card-title">Total Claims</h5>
                    <h3>@Model.TotalClaims</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <h5 class="card-title">Approved Claims</h5>
                    <h3>@Model.ApprovedClaims</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-dark">
                <div class="card-body">
                    <h5 class="card-title">Pending Claims</h5>
                    <h3>@Model.PendingClaims</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-white">
                <div class="card-body">
                    <h5 class="card-title">Total Claim Amount</h5>
                    <h3>@Model.TotalClaimAmount.ToString("C")</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Claims -->
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Recent Claims</h5>
                </div>
                <div class="card-body">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Claim ID</th>
                                <th>Lecturer Name</th>
                                <th>Department</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Submission Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var claim in Model.RecentClaims)
                            {
                                <tr>
                                    <td>@claim.ClaimId</td>
                                    <td>@claim.LecturerName</td>
                                    <td>@claim.Department</td>
                                    <td>@claim.TotalAmount.ToString("C")</td>
                                    <td>
                                        <span class="badge @(claim.Status == ClaimStatus.Approved ? "bg-success" : 
                                                           claim.Status == ClaimStatus.Pending ? "bg-warning" : 
                                                           claim.Status == ClaimStatus.Rejected ? "bg-danger" : 
                                                           claim.Status == ClaimStatus.PendingReview ? "bg-info" :
                                                           claim.Status == ClaimStatus.PendingAcademicManagerApproval ? "bg-primary" : "bg-secondary")">
                                            @claim.Status
                                        </span>
                                    </td>
                                    <td>@claim.SubmissionDate.ToString("dd MMM yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Lecturer Claim Summaries -->
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Lecturer Claim Summaries</h5>
                </div>
                <div class="card-body">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Department</th>
                                <th>Total Claims</th>
                                <th>Total Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model.UserSummaries)
                            {
                                <tr>
                                    <td>@user.Name</td>
                                    <td>@user.Department</td>
                                    <td>@user.TotalClaims</td>
                                    <td>@user.TotalClaimAmount.ToString("C")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Lecturer Management Section -->
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Lecturer Management</h4>
            <button type="button" class="btn btn-primary" onclick="addNewLecturer()">
                <i class="fas fa-plus"></i> Add New Lecturer
            </button>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Department</th>
                            <th>Email</th>
                            <th>Specialization</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var lecturer in Model.Lecturers)
                        {
                            <tr>
                                <td>@(lecturer.FirstName + " " + lecturer.LastName)</td>
                                <td>@lecturer.Department</td>
                                <td>@lecturer.Email</td>
                                <td>@lecturer.Specialization</td>
                                <td>@(lecturer.IsActive ? "Active" : "Inactive")</td>
                                <td>
                                    <a href="@Url.Action("EditLecturer", "HR", new { id = lecturer.Id })" class="btn btn-primary btn-sm">Edit</a>
                                    <button onclick="toggleLecturerStatus('@lecturer.Id', @lecturer.IsActive.ToString().ToLower())" class="btn @(lecturer.IsActive ? "btn-danger" : "btn-success") btn-sm">
                                        @(lecturer.IsActive ? "Deactivate" : "Activate")
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Edit Lecturer Modal -->
<div class="modal fade" id="editLecturerModal" tabindex="-1" role="dialog" aria-labelledby="editLecturerModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editLecturerModalLabel">Edit Lecturer</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editLecturerForm">
                    <input type="hidden" id="lecturerId" name="Id" />
                    <div class="mb-3">
                        <label for="firstName" class="form-label">First Name</label>
                        <input type="text" class="form-control" id="firstName" name="FirstName" required>
                    </div>
                    <div class="mb-3">
                        <label for="lastName" class="form-label">Last Name</label>
                        <input type="text" class="form-control" id="lastName" name="LastName" required>
                    </div>
                    <div class="mb-3">
                        <label for="email" class="form-label">Email</label>
                        <input type="email" class="form-control" id="email" name="Email" required>
                    </div>
                    <div class="mb-3">
                        <label for="phoneNumber" class="form-label">Phone Number</label>
                        <input type="tel" class="form-control" id="phoneNumber" name="PhoneNumber">
                    </div>
                    <div class="mb-3">
                        <label for="department" class="form-label">Department</label>
                        <input type="text" class="form-control" id="department" name="Department" required>
                    </div>
                    <div class="mb-3">
                        <label for="specialization" class="form-label">Specialization</label>
                        <input type="text" class="form-control" id="specialization" name="Specialization">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" onclick="saveLecturerChanges()">Save changes</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Optional: Add any dashboard-specific scripts here
        });

        function editLecturer(id) {
            $.get('/HR/GetLecturer/' + id, function(data) {
                $('#lecturerId').val(data.id);
                $('#firstName').val(data.firstName);
                $('#lastName').val(data.lastName);
                $('#email').val(data.email);
                $('#phoneNumber').val(data.phoneNumber);
                $('#department').val(data.department);
                $('#specialization').val(data.specialization);
                $('#editLecturerModal').modal('show');
            });
        }

        function saveLecturerChanges() {
            var formData = $('#editLecturerForm').serialize();
            $.post('/HR/UpdateLecturer', formData, function(response) {
                if (response.success) {
                    $('#editLecturerModal').modal('hide');
                    window.location.reload();
                } else {
                    alert('Error updating lecturer: ' + response.message);
                }
            });
        }

        function toggleLecturerStatus(lecturerId, currentStatus) {
            if (confirm('Are you sure you want to ' + (currentStatus ? 'deactivate' : 'activate') + ' this lecturer?')) {
                $.post('@Url.Action("ToggleLecturerStatus", "HR")', { id: lecturerId })
                    .done(function() {
                        location.reload();
                    })
                    .fail(function() {
                        alert('Failed to update lecturer status. Please try again.');
                    });
            }
        }

        function addNewLecturer() {
            // Add new lecturer functionality here
        }
    </script>
}
