@model CMCS.Models.RegisterViewModel

@{
    ViewData["Title"] = "Register";
    Layout = "_Layout";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin="" />
    <link rel="stylesheet"
          as="style"
          onload="this.rel='stylesheet'"
          href="https://fonts.googleapis.com/css2?display=swap&amp;family=Work+Sans%3Awght%40400%3B500%3B700%3B900" />
    <title>Register</title>
    <link rel="stylesheet" href="~/css/site.css">
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
</head>
<body class="bg-white">
    <div class="page-container">
        <div class="form-container">
            <h3 class="text-[#111418] tracking-light text-2xl font-bold leading-tight text-center pb-6">Create an account</h3>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger text-red-700 bg-red-100 border border-red-300 rounded-lg p-4 mb-4" role="alert">
                    <ul>
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <form asp-action="Register" method="post" class="space-y-4">
                <div class="form-group">
                    <label asp-for="FirstName" class="block text-sm font-medium text-gray-700"></label>
                    <input asp-for="FirstName" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" />
                    <span asp-validation-for="FirstName" class="text-red-500"></span>
                </div>

                <div class="form-group">
                    <label asp-for="LastName" class="block text-sm font-medium text-gray-700"></label>
                    <input asp-for="LastName" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" />
                    <span asp-validation-for="LastName" class="text-red-500"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Email" class="block text-sm font-medium text-gray-700"></label>
                    <input asp-for="Email" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" />
                    <span asp-validation-for="Email" class="text-red-500"></span>
                </div>

                <div class="form-group">
                    <label asp-for="UserName" class="block text-sm font-medium text-gray-700"></label>
                    <input asp-for="UserName" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" />
                    <span asp-validation-for="UserName" class="text-red-500"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Department" class="block text-sm font-medium text-gray-700"></label>
                    <input asp-for="Department" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" />
                    <span asp-validation-for="Department" class="text-red-500"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Password" class="block text-sm font-medium text-gray-700"></label>
                    <input asp-for="Password" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" />
                    <span asp-validation-for="Password" class="text-red-500"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ConfirmPassword" class="block text-sm font-medium text-gray-700"></label>
                    <input asp-for="ConfirmPassword" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" />
                    <span asp-validation-for="ConfirmPassword" class="text-red-500"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Role" class="block text-sm font-medium text-gray-700"></label>
                    <select asp-for="Role" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
                        <option value="">Select Role</option>
                        <option value="Lecturer">Lecturer</option>
                        <option value="ProgrammeCoordinator">Programme Coordinator</option>
                        <option value="AcademicManager">Academic Manager</option>
                    </select>
                    <span asp-validation-for="Role" class="text-red-500"></span>
                </div>

                <div class="form-group">
                    <button type="submit" class="w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                        Register
                    </button>
                </div>
            </form>

            <div class="mt-4 text-center">
                <p class="text-sm text-gray-600">
                    Already have an account? <a asp-action="Login" class="font-medium text-indigo-600 hover:text-indigo-500">Sign in</a>
                </p>
            </div>
        </div>
    </div>

    @section Scripts {
        @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    }
</body>
</html>
