@model CMCS.Models.User

@{
    ViewData["Title"] = "Register";
    var successMessage = TempData["SuccessMessage"] as string;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin="" />
    <link rel="stylesheet"
          as="style"
          onload="this.rel='stylesheet'"
          href="https://fonts.googleapis.com/css2?display=swap&amp;family=Noto+Sans%3Awght%40400%3B500%3B700%3B900&amp;family=Work+Sans%3Awght%40400%3B500%3B700%3B900" />

    <title>Register</title>
    <link rel="icon" type="image/x-icon" href="data:image/x-icon;base64," />

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link rel=stylesheet href="~/css/site.css">
</head>
<body class="bg-white">
    <div class="page-container">
        <div class="form-container">
            <h3 class="text-[#111418] tracking-light text-2xl font-bold leading-tight text-center pb-6">Create an account</h3>

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success text-green-700 bg-green-100 border border-green-300 rounded-lg p-4 mb-4" role="alert">
                    @successMessage
                </div>
                <script>
                    setTimeout(function () {
                        window.location.href = '@Url.Action("Login", "Account")';
                    }, 5000);
                </script>
            }

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger text-red-700 bg-red-100 border border-red-300 rounded-lg p-4 mb-4" role="alert">
                    <ul>
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <form id="signUpForm" method="post" asp-action="Register" class="space-y-6">
                <div>
                    <input asp-for="Name"
                           placeholder="Name"
                           class="form-input w-full rounded-xl text-[#111418] focus:outline-0 focus:ring-0 border border-[#dbdfe6] bg-white focus:border-[#dbdfe6] h-14 placeholder:text-[#617189] p-[15px] text-base font-normal leading-normal"
                           required />
                </div>

                <div>
                    <input asp-for="EmailOrUsername"
                           placeholder="Enter Username or Email"
                           class="form-input w-full rounded-xl text-[#111418] focus:outline-0 focus:ring-0 border border-[#dbdfe6] bg-white focus:border-[#dbdfe6] h-14 placeholder:text-[#617189] p-[15px] text-base font-normal leading-normal"
                           required />
                    <p class="text-[#617189] text-sm font-normal leading-normal pt-1">Please enter a valid email address or username.</p>
                </div>

                <div>
                    <input asp-for="Password"
                           type="password"
                           placeholder="Password"
                           class="form-input w-full rounded-xl text-[#111418] focus:outline-0 focus:ring-0 border border-[#dbdfe6] bg-white focus:border-[#dbdfe6] h-14 placeholder:text-[#617189] p-[15px] text-base font-normal leading-normal"
                           required />
                    <p class="text-[#617189] text-sm font-normal leading-normal pt-1">Your password must be at least 8 characters long</p>
                </div>

                <div>
                    <input name="confirmPassword"
                           type="password"
                           placeholder="Confirm Password"
                           class="form-input w-full rounded-xl text-[#111418] focus:outline-0 focus:ring-0 border border-[#dbdfe6] bg-white focus:border-[#dbdfe6] h-14 placeholder:text-[#617189] p-[15px] text-base font-normal leading-normal"
                           required />
                </div>

                <div>
                    <select asp-for="Role"
                            class="form-input w-full rounded-xl text-[#111418] focus:outline-0 focus:ring-0 border border-[#dbdfe6] bg-white focus:border-[#dbdfe6] h-14 p-[15px]"
                            required>
                        <option value="" disabled selected>Select Role</option>
                        <option value="Lecturer">Lecturer</option>
                        <option value="ProgrammeCoordinator">Programme Coordinator</option>
                        <option value="AcademicManager">Academic Manager</option>
                    </select>
                </div>

                <div>
                    <button type="submit" class="w-full cursor-pointer overflow-hidden rounded-xl h-14 bg-[#1366ec] text-white text-sm font-bold leading-normal tracking-[0.015em]">
                        <span class="truncate">Sign Up</span>
                    </button>
                </div>

                <p class="text-[#617189] text-sm font-normal leading-normal text-center">Already have an account?</p>
                <div>
                    <a href="/Account/Login" class="flex w-full cursor-pointer items-center justify-center overflow-hidden rounded-xl h-14 bg-[#e7edf3] text-[#0e141b] text-sm font-bold leading-normal tracking-[0.015em]">
                        <span class="truncate">Login</span>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <script src="~/js/validation.js"></script>
</body>
</html>