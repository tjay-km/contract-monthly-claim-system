@{
    ViewData["Title"] = "Login";

    Layout = "_Layout";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin="" />
    <link rel="stylesheet"
          as="style"
          onload="this.rel='stylesheet'"
          href="https://fonts.googleapis.com/css2?display=swap&amp;family=Inter%3Awght%40400%3B500%3B700%3B900&amp;family=Noto+Sans%3Awght%40400%3B500%3B700%3B900" />
    <title>Login - CMCS</title>
    <link rel="icon" type="image/x-icon" href="data:image/x-icon;base64," />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link rel="stylesheet" href="~/css/site.css">
</head>
<body class="bg-white">
    <div class="page-container">
        <div class="form-container">
            <h1 class="text-[#0e141b] text-[22px] font-bold leading-tight tracking-[-0.015em] text-center pb-6">Log in to ContractClaim</h1>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger text-red-700 bg-red-100 border border-red-300 rounded-lg p-4 mb-4" role="alert">
                    <ul>
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))

                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <form id="loginForm" method="post" asp-action="Login" class="space-y-6">
                <div>
                    <input name="usernameOrEmail"
                           placeholder="Enter Username or Email"
                           class="form-input w-full rounded-xl text-[#0e141b] focus:outline-0 focus:ring-0 border border-[#d0dbe7] bg-slate-50 focus:border-[#d0dbe7] h-14 placeholder:text-[#4e7397] p-[15px] text-base font-normal leading-normal"
                           required />
                </div>
                <div>
                    <input name="password"
                           type="password"
                           placeholder="Enter Password"
                           class="form-input w-full rounded-xl text-[#0e141b] focus:outline-0 focus:ring-0 border border-[#d0dbe7] bg-slate-50 focus:border-[#d0dbe7] h-14 placeholder:text-[#4e7397] p-[15px] text-base font-normal leading-normal"
                           required />
                </div>
                <p class="text-[#4e7397] text-sm font-normal leading-normal pb-3 pt-1 text-center">
                    <a href="#" class="underline">Forgot your password?</a>
                </p>
                <div>
                    <button type="submit"
                            class="w-full cursor-pointer overflow-hidden rounded-xl h-14 bg-[#1980e6] text-white text-sm font-bold leading-normal tracking-[0.015em]">
                        <span class="truncate">Log in</span>
                    </button>
                </div>
            </form>
            <p class="text-[#4e7397] text-sm font-normal leading-normal pt-6 text-center">
                Don't have an account?
                <a href="/Account/Register" class="text-blue-600 underline">Sign up</a>
            </p>
        </div>
    </div>
</body>
</html>