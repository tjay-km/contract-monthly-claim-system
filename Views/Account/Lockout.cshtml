@{
    ViewData["Title"] = "Account locked";
}

<div class="max-w-md mx-auto mt-16 bg-white shadow-md rounded px-8 py-8 text-center">
    <h1 class="text-2xl font-bold mb-4">Account temporarily locked</h1>
    <p class="text-gray-700 mb-6">Too many failed sign-in attempts. Please wait a few minutes and try again.</p>
    <a asp-action="Login" class="text-indigo-600 hover:text-indigo-500 font-medium">Back to sign in</a>
</div>
