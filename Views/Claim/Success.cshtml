@model CMCS.Models.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Claim Submitted Successfully";
}

<div class="container mt-5">
    <h1 class="text-center">Claim Submitted Successfully</h1>
    <p>Your claim has been submitted successfully!</p>
    <a href="@Url.Action("Submit", "Claim")" class="btn btn-primary">Submit Another Claim</a>

    <!-- Optional: Displaying submitted claims or pending claims if needed -->
    <h2 class="mt-5">Your Claims</h2>
    <ul>
        @foreach (var claim in Model.Claims)
        {
            <li>@claim.Id - @claim.HoursWorked hours at @claim.HourlyRate.ToString("C")</li>
        }
    </ul>

    <h2 class="mt-5">Pending Claims</h2>
    <ul>
        @foreach (var claim in Model.PendingClaims)
        {
            <li>@claim.Id - @claim.HoursWorked hours at @claim.HourlyRate.ToString("C")</li>
        }
    </ul>
</div>
