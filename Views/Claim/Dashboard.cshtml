@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-5">
    <h1 class="text-center">Contract Monthly Claim System</h1>
    <div class="row mt-4">
        <div class="col-md-12">
            <h3>Claims Overview</h3>
            <table class="table table-bordered table-striped">
                <thead class="thead-dark">
                    <tr>
                        <th>Claim ID</th>
                        <th>Lecturer Name</th>
                        <th>Hours Worked</th>
                        <th>Hourly Rate</th>
                        <th>Total Amount</th>
                        <th>Status</th>
                        <th>Supporting Document</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Sample claim data (replace with actual data from your model) -->
                    <tr>
                        <td>1</td>
                        <td>John Doe</td>
                        <td>30</td>
                        <td>$50</td>
                        <td>$1500</td>
                        <td>Pending</td>
                        <td><a href="#">Document.pdf</a></td>
                        <td>
                            <a href="#" class="btn btn-success btn-sm">Approve</a>
                            <a href="#" class="btn btn-danger btn-sm">Reject</a>
                        </td>
                    </tr>
                    <tr>
                        <td>2</td>
                        <td>Jane Smith</td>
                        <td>25</td>
                        <td>$45</td>
                        <td>$1125</td>
                        <td>Approved</td>
                        <td><a href="#">Document.pdf</a></td>
                        <td>
                            <a href="#" class="btn btn-primary btn-sm">View</a>
                        </td>
                    </tr>
                    <!-- More claims can be added dynamically from model -->
                </tbody>
            </table>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-md-12">
            <h3>Submit New Claim</h3>
            <form method="post" action="/Claims/SubmitClaim">
                <div class="form-group">
                    <label for="lecturerName">Lecturer Name</label>
                    <input type="text" class="form-control" id="lecturerName" name="lecturerName" required />
                </div>
                <div class="form-group">
                    <label for="hoursWorked">Hours Worked</label>
                    <input type="number" class="form-control" id="hoursWorked" name="hoursWorked" required />
                </div>
                <div class="form-group">
                    <label for="hourlyRate">Hourly Rate</label>
                    <input type="number" class="form-control" id="hourlyRate" name="hourlyRate" required />
                </div>
                <div class="form-group">
                    <label for="document">Upload Supporting Document</label>
                    <input type="file" class="form-control" id="document" name="document" required />
                </div>
                <button type="submit" class="btn btn-primary">Submit Claim</button>
            </form>
        </div>
    </div>
</div>
