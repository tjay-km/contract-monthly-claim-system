@model CMCS.Models.Claim

@{
    ViewData["Title"] = "Claim Details";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin="" />
    <link rel="stylesheet" href="~/css/site.css" />
    <title>Claim Details</title>
</head>
<body class="bg-slate-50 min-h-screen flex flex-col">
    <div class="flex-grow flex items-center justify-center px-4 sm:px-6 lg:px-8">
        <div class="max-w-lg w-full space-y-4 p-6 bg-white rounded-lg shadow-md">
            <h2 class="text-center text-2xl font-bold text-[#0e141b]">Claim Status</h2>
            <p><strong>Lecturer:</strong> @Model.LecturerName</p>
            <p><strong>Hours Worked:</strong> @Model.HoursWorked</p>
            <p><strong>Hourly Rate:</strong> @Model.HourlyRate</p>
            <p><strong>Status:</strong> @Model.Status</p>

            @if (Model.Status == "Pending")
            {
                <p class="text-yellow-600">Your claim is under review.</p>
            }
            else if (Model.Status == "Approved")
            {
                <p class="text-green-600">Your claim has been approved!</p>
            }
            else
            {
                <p class="text-red-600">Your claim was rejected.</p>
            }

            @if (!string.IsNullOrEmpty(Model.AdditionalNotes))
            {
                <h3 class="text-lg font-semibold">Additional Notes:</h3>
                <p>@Model.AdditionalNotes</p>
            }

            @if (!string.IsNullOrEmpty(Model.SupportingDocumentPath))
            {
                <h3 class="text-lg font-semibold">Supporting Document:</h3>
                <a href="@Url.Content(Model.SupportingDocumentPath)" target="_blank" class="text-blue-600 underline">View Document</a>
            }

            <div class="flex justify-center">
                <a href="@Url.Action("Index", "Dashboard")" class="mt-4 px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">Back to Claims</a>
            </div>
        </div>
    </div>
</body>
</html>
