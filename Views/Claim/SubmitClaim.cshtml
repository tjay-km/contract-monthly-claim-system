@model CMCS.Models.Claim

@{
    ViewData["Title"] = "Submit Claim";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin="" />
    <link rel="stylesheet" href="~/css/site.css" />
    <title>Submit Claim</title>
</head>
<body class="bg-slate-50 min-h-screen flex flex-col">
    <div class="flex-grow flex items-center justify-center px-4 sm:px-6 lg:px-8">
        <div class="max-w-md w-full space-y-8">
            <h2 class="text-center text-2xl font-bold text-[#0e141b]">Submit Claim</h2>

            <form asp-action="SubmitClaim" method="post" enctype="multipart/form-data" class="space-y-4">
                <div>
                    <label for="LecturerName" class="block text-sm font-medium text-gray-700">Lecturer Name</label>
                    <input type="text" id="LecturerName" name="LecturerName" required
                           class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" />
                </div>

                <div>
                    <label for="HoursWorked" class="block text-sm font-medium text-gray-700">Hours Worked</label>
                    <input type="number" id="HoursWorked" name="HoursWorked" required
                           class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" />
                </div>

                <div>
                    <label for="HourlyRate" class="block text-sm font-medium text-gray-700">Hourly Rate</label>
                    <input type="number" id="HourlyRate" name="HourlyRate" step="0.01" required
                           class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" />
                </div>

                <div>
                    <label for="SupportingDocument" class="block text-sm font-medium text-gray-700">Upload Supporting Document</label>
                    <input type="file" id="SupportingDocument" name="SupportingDocument" required
                           class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" />
                </div>

                <button type="submit" class="w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                    Submit Claim
                </button>
            </form>
        </div>
    </div>
</body>
</html>
