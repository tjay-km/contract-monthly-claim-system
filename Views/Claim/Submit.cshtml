@model CMCS.Models.Claim
@using System.Security.Claims

@{
    ViewData["Title"] = "Submit Claim";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h3 class="card-title mb-0">Submit New Claim</h3>
                </div>
                <div class="card-body">
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger">
                            @TempData["ErrorMessage"]
                        </div>
                    }
                    <form asp-action="Submit" method="post" enctype="multipart/form-data" id="claimForm" class="needs-validation" novalidate>
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <input type="hidden" asp-for="LecturerId" />

                        <div class="form-group mb-3">
                            <label asp-for="LecturerName" class="control-label"></label>
                            <input asp-for="LecturerName" class="form-control" readonly />
                            <span asp-validation-for="LecturerName" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="HoursWorked" class="control-label"></label>
                                    <input asp-for="HoursWorked" class="form-control" type="number" step="0.5" min="0.5" max="195" id="hoursWorked" />
                                    <span asp-validation-for="HoursWorked" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="HourlyRate" class="control-label"></label>
                                    <input asp-for="HourlyRate" class="form-control" type="number" step="0.01" min="1" max="20000" id="hourlyRate" />
                                    <span asp-validation-for="HourlyRate" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="TotalAmount" class="control-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">R</span>
                                <input type="text" class="form-control" readonly id="totalAmountDisplay" />
                                <input type="number" asp-for="TotalAmount" id="totalAmount" class="d-none" min="0.01" max="3900000" step="0.01" required />
                            </div>
                            <span asp-validation-for="TotalAmount" class="text-danger"></span>
                            <small class="text-muted">Amount must be between R0.01 and R3,900,000</small>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="LecturerDepartment" class="control-label"></label>
                            <input asp-for="LecturerDepartment" class="form-control" required />
                            <span asp-validation-for="LecturerDepartment" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="ModuleCode" class="control-label"></label>
                            <input asp-for="ModuleCode" class="form-control" required />
                            <span asp-validation-for="ModuleCode" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="AdditionalNotes" class="control-label"></label>
                            <textarea asp-for="AdditionalNotes" class="form-control" rows="4" minlength="10" maxlength="500" required></textarea>
                            <span asp-validation-for="AdditionalNotes" class="text-danger"></span>
                            <small class="text-muted">Please provide detailed information about the work performed (10-500 characters)</small>
                            <div class="invalid-feedback">
                                Additional notes must be between 10 and 500 characters.
                            </div>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="SupportingDocument" class="control-label"></label>
                            <input type="file" name="supportingDocument" class="form-control" accept=".pdf,.doc,.docx" required />
                            <span asp-validation-for="SupportingDocument" class="text-danger"></span>
                            <small class="text-muted">Accepted formats: PDF, DOC, DOCX (max 5MB)</small>
                        </div>

                        <div class="form-group text-center">
                            <button type="submit" class="btn btn-primary">Submit Claim</button>
                            <a asp-action="Dashboard" class="btn btn-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">Claim Guidelines</h5>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item">
                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                            Hours worked must be between 0.5 and 195
                        </li>
                        <li class="list-group-item">
                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                            Hourly rate must be between R1 and R20,000
                        </li>
                        <li class="list-group-item">
                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                            Supporting documents must be PDF, DOC, or DOCX
                        </li>
                        <li class="list-group-item">
                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                            Maximum file size: 5MB
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function calculateTotal() {
            var hours = parseFloat(document.getElementById('hoursWorked').value) || 0;
            var rate = parseFloat(document.getElementById('hourlyRate').value) || 0;
            var total = (hours * rate).toFixed(2);
            
            if (total <= 0 || total > 3900000) {
                document.getElementById('totalAmountDisplay').classList.add('is-invalid');
                document.getElementById('totalAmount').setCustomValidity('Amount must be between R0.01 and R3,900,000');
            } else {
                document.getElementById('totalAmountDisplay').classList.remove('is-invalid');
                document.getElementById('totalAmount').setCustomValidity('');
            }
            
            // Format display amount with thousand separators
            document.getElementById('totalAmountDisplay').value = parseFloat(total).toLocaleString('en-ZA', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });
            document.getElementById('totalAmount').value = total;
        }

        // Calculate total on page load and input changes
        document.addEventListener('DOMContentLoaded', function() {
            calculateTotal();
            
            document.getElementById('hoursWorked').addEventListener('input', function() {
                if (this.value < 0.5 || this.value > 195) {
                    this.classList.add('is-invalid');
                } else {
                    this.classList.remove('is-invalid');
                }
                calculateTotal();
            });
            
            document.getElementById('hourlyRate').addEventListener('input', function() {
                if (this.value < 1 || this.value > 20000) {
                    this.classList.add('is-invalid');
                } else {
                    this.classList.remove('is-invalid');
                }
                calculateTotal();
            });

            // Add character count display for additional notes
            var additionalNotes = document.querySelector('[asp-for="AdditionalNotes"]');
            var charCount = document.createElement('small');
            charCount.className = 'text-muted d-block mt-1';
            additionalNotes.parentNode.insertBefore(charCount, additionalNotes.nextSibling);

            function updateCharCount() {
                var length = additionalNotes.value.length;
                charCount.textContent = `Characters: ${length}/500`;
                
                if (length < 10 || length > 500) {
                    additionalNotes.classList.add('is-invalid');
                } else {
                    additionalNotes.classList.remove('is-invalid');
                }
            }

            additionalNotes.addEventListener('input', updateCharCount);
            updateCharCount(); // Initial count
        });

        // Form validation
        document.getElementById('claimForm').addEventListener('submit', function(e) {
            var additionalNotes = document.querySelector('[asp-for="AdditionalNotes"]');
            var length = additionalNotes.value.length;
            
            if (length < 10 || length > 500) {
                e.preventDefault();
                additionalNotes.classList.add('is-invalid');
                return;
            }

            var fileInput = document.querySelector('input[type="file"]');
            if (fileInput.files.length === 0) {
                e.preventDefault();
                alert('Please select a supporting document');
                return;
            }

            if (fileInput.files.length > 0) {
                var fileSize = fileInput.files[0].size;
                var maxSize = 5 * 1024 * 1024; // 5MB
                if (fileSize > maxSize) {
                    e.preventDefault();
                    alert('File size cannot exceed 5MB');
                }
            }
        });
    </script>
}
