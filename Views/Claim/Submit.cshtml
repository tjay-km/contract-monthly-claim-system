@model CMCS.Models.Claim
@{
    ViewData["Title"] = "Submit Claim";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-body">
                    <h2 class="text-center mb-4">Submit New Claim</h2>
                    <form asp-action="Submit" method="post" enctype="multipart/form-data" id="claimForm" class="needs-validation" novalidate>
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="row">
                            <div class="col-md-8">
                                <div class="form-group mb-3">
                                    <label asp-for="DepartmentId" class="form-label">Department</label>
                                    <select asp-for="DepartmentId" 
                                            asp-items="@(new SelectList(ViewBag.Departments, "Id", "Name"))"
                                            class="form-control"
                                            required>
                                        <option value="">Select Department</option>
                                    </select>
                                    <span asp-validation-for="DepartmentId" class="text-danger"></span>
                                    <div class="valid-feedback">Looks good!</div>
                                    <div class="invalid-feedback">Please select a department.</div>
                                </div>

                                <div class="form-group mb-3">
                                    <label asp-for="ModuleId" class="form-label">Module</label>
                                    <select asp-for="ModuleId" 
                                            class="form-control"
                                            required>
                                        <option value="">Select Module</option>
                                    </select>
                                    <span asp-validation-for="ModuleId" class="text-danger"></span>
                                    <div class="valid-feedback">Looks good!</div>
                                    <div class="invalid-feedback">Please select a module.</div>
                                </div>

                                <div class="form-group mb-3">
                                    <label asp-for="HoursWorked" class="form-label">Hours Worked</label>
                                    <input asp-for="HoursWorked" type="number" min="0.5" max="195" step="0.5" 
                                           class="form-control" id="hoursWorked" required />
                                    <span asp-validation-for="HoursWorked" class="text-danger"></span>
                                    <div class="valid-feedback">Looks good!</div>
                                    <div class="invalid-feedback">Hours must be between 0.5 and 195.</div>
                                </div>

                                <div class="form-group mb-3">
                                    <label asp-for="HourlyRate" class="form-label">Hourly Rate (R)</label>
                                    <input asp-for="HourlyRate" type="number" min="1" max="20000" step="0.01" 
                                           class="form-control" id="hourlyRate" required />
                                    <span asp-validation-for="HourlyRate" class="text-danger"></span>
                                    <div class="valid-feedback">Looks good!</div>
                                    <div class="invalid-feedback">Rate must be between R1 and R20,000.</div>
                                </div>

                                <div class="form-group mb-3">
                                    <label class="form-label">Total Amount (R)</label>
                                    <input type="text" id="totalAmountDisplay" class="form-control" readonly />
                                    <input type="hidden" id="totalAmountValue" name="TotalAmount" />
                                    <div class="valid-feedback">Total amount calculated.</div>
                                    <div class="invalid-feedback">Please enter valid hours and rate.</div>
                                </div>

                                <div class="form-group mb-3">
                                    <label asp-for="AdditionalNotes" class="form-label">Additional Notes</label>
                                    <textarea asp-for="AdditionalNotes" rows="3" class="form-control" 
                                              minlength="10" maxlength="500" required></textarea>
                                    <span asp-validation-for="AdditionalNotes" class="text-danger"></span>
                                    <div class="valid-feedback">Looks good!</div>
                                    <div class="invalid-feedback">Notes must be between 10 and 500 characters.</div>
                                </div>

                                <div class="form-group mb-3">
                                    <label for="supportingDocument" class="form-label">Supporting Document</label>
                                    <input type="file" name="supportingDocument" id="supportingDocument" 
                                           accept=".pdf,.doc,.docx" class="form-control" required />
                                    <div class="valid-feedback">File selected.</div>
                                    <div class="invalid-feedback">Please select a valid document (PDF, DOC, or DOCX, max 5MB).</div>
                                </div>

                                <div class="d-flex justify-content-between gap-3">
                                    <a asp-action="Index" asp-controller="Dashboard" 
                                       class="btn btn-secondary w-50">
                                        Cancel
                                    </a>
                                    <button type="submit" class="btn btn-primary w-50">
                                        Submit Claim
                                    </button>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="card">
                                    <div class="card-body">
                                        <h5 class="card-title mb-3">Claim Guidelines</h5>
                                        <ul class="list-unstyled">
                                            <li class="mb-2">
                                                <i class="fas fa-info-circle text-primary me-2"></i>
                                                Hours worked must be between 0.5 and 195 hours
                                            </li>
                                            <li class="mb-2">
                                                <i class="fas fa-info-circle text-primary me-2"></i>
                                                Hourly rate must be between R1 and R20,000
                                            </li>
                                            <li class="mb-2">
                                                <i class="fas fa-info-circle text-primary me-2"></i>
                                                Additional notes must be between 10 and 500 characters
                                            </li>
                                            <li class="mb-2">
                                                <i class="fas fa-info-circle text-primary me-2"></i>
                                                Supporting documents must be in PDF, DOC, or DOCX format and under 5MB
                                            </li>
                                            <li class="mb-2">
                                                <i class="fas fa-info-circle text-primary me-2"></i>
                                                Claims under R5,000 are auto-approved
                                            </li>
                                            <li class="mb-2">
                                                <i class="fas fa-info-circle text-primary me-2"></i>
                                                Total claim amount cannot exceed R3,900,000
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Handle department change to load modules
            $('#DepartmentId').change(function() {
                var departmentId = $(this).val();
                var moduleSelect = $('#ModuleId');
                moduleSelect.empty();
                moduleSelect.append('<option value="">Select Module</option>');
                
                if (departmentId) {
                    $.get('/api/Claim/GetModules/' + departmentId, function(modules) {
                        if (modules.error) {
                            console.error(modules.error);
                            return;
                        }
                        $.each(modules, function(i, module) {
                            moduleSelect.append($('<option></option>')
                                .attr('value', module.id)
                                .text(module.name));
                        });
                    });
                }
            });

            // Calculate total amount when hours or rate changes
            function calculateTotal() {
                var hours = parseFloat($('#hoursWorked').val()) || 0;
                var rate = parseFloat($('#hourlyRate').val()) || 0;
                var total = (hours * rate).toFixed(2);
                $('#totalAmountDisplay').val('R ' + total);
                $('#totalAmountValue').val(total);
            }

            $('#hoursWorked, #hourlyRate').on('input', calculateTotal);

            // Form validation
            (function() {
                'use strict';
                var forms = document.querySelectorAll('.needs-validation');
                Array.prototype.slice.call(forms).forEach(function(form) {
                    form.addEventListener('submit', function(event) {
                        if (!form.checkValidity()) {
                            event.preventDefault();
                            event.stopPropagation();
                        }
                        form.classList.add('was-validated');
                    }, false);
                });
            })();
        });
    </script>
}
