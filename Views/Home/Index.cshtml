@{
    Layout = "_Layout"; // Specify the layout you want to use

    ViewData["Title"] = "Home";
}

<div class="container mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="max-w-7xl mx-auto">
        <div class="space-y-12">
            <div class="bg-cover bg-center bg-no-repeat rounded-xl overflow-hidden"
                 style='background-image: linear-gradient(rgba(0, 0, 0, 0.1) 0%, rgba(0, 0, 0, 0.4) 100%), url("https://cdn.usegalileo.ai/sdxl10/d4b39fb7-37f2-479f-bee4-f49109c84a63.png");'>
                <div class="px-6 py-12 sm:px-12 sm:py-24 flex flex-col items-start justify-end min-h-[480px]">
                    <div class="max-w-xl">
                        <h1 class="text-white text-4xl sm:text-5xl font-black leading-tight tracking-tight mb-4">
                            Submit your claim in 5 minutes
                        </h1>
                        <h2 class="text-white text-lg sm:text-xl font-normal mb-8">
                            Claim your income, expenses and evidence
                        </h2>
                        <a href="/Claim/Dashboard" class="bg-[#1366ec] text-white font-bold py-3 px-6 rounded-xl text-lg hover:bg-blue-700 transition duration-300">
                            Get Started
                        </a>
                    </div>
                </div>
            </div>

            <div class="bg-cover bg-center bg-no-repeat rounded-xl overflow-hidden"
                 style='background-image: linear-gradient(rgba(0, 0, 0, 0.1) 0%, rgba(0, 0, 0, 0.4) 100%), url("https://cdn.usegalileo.ai/sdxl10/b5f90836-e94d-4130-bd22-be7a8cdd9cb2.png");'>
                <div class="px-6 py-12 sm:px-12 sm:py-24 flex flex-col items-start justify-end min-h-[480px]">
                    <div class="max-w-xl">
                        <h1 class="text-white text-4xl sm:text-5xl font-black leading-tight tracking-tight mb-4">
                            Review a claim in 5 minutes
                        </h1>
                        <h2 class="text-white text-lg sm:text-xl font-normal mb-8">
                            Claim your income, expenses and evidence
                        </h2>
                        <a href="/Dashboard/Index" class="bg-[#1366ec] text-white font-bold py-3 px-6 rounded-xl text-lg hover:bg-blue-700 transition duration-300">
                            Get Started
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
