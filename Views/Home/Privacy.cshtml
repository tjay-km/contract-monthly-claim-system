@{
    ViewData["Title"] = "Privacy Policy - Contract Monthly Claim System";
    Layout = "_Layout";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/css/site.css" />
    <title>Privacy Policy - Contract Monthly Claim System</title>
</head>
<body class="bg-slate-50">
    <div class="flex justify-center items-center min-h-screen">
        <div class="bg-white shadow-md rounded-lg p-6 max-w-4xl w-full">
            <h1 class="text-3xl font-bold text-center mb-4">Privacy Policy</h1>
            <h2 class="text-xl font-semibold">1. Information Collection</h2>
            <p>We collect personal information from you when you register for an account, submit a claim, or contact us for support.</p>
            <h2 class="text-xl font-semibold">2. Use of Information</h2>
            <p>Your information is used to process claims, improve our services, and communicate with you about your account and claims.</p>
            <h2 class="text-xl font-semibold">3. Information Sharing</h2>
            <p>We do not sell or share your personal information with third parties without your consent, except as required by law.</p>
            <h2 class="text-xl font-semibold">4. Data Security</h2>
            <p>We implement reasonable security measures to protect your personal information from unauthorized access and disclosure.</p>
            <h2 class="text-xl font-semibold">5. Changes to Privacy Policy</h2>
            <p>We may update this Privacy Policy from time to time. Any changes will be effective immediately upon posting on this page.</p>
        </div>
    </div>
</body>
</html>
