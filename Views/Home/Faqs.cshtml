@{
    ViewData["Title"] = "FAQs - Contract Monthly Claim System";
    Layout = "_Layout";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/css/site.css" />
    <title>FAQs - Contract Monthly Claim System</title>
</head>
<body class="bg-slate-50">
    <div class="flex justify-center items-center min-h-screen">
        <div class="bg-white shadow-md rounded-lg p-6 max-w-4xl w-full">
            <h1 class="text-3xl font-bold text-center mb-4">Frequently Asked Questions (FAQs)</h1>
            <ul class="space-y-4">
                <li>
                    <strong>Q: How do I submit a claim?</strong><br />
                    A: To submit a claim, log into your account, navigate to the claims section, and fill out the submission form. Make sure to attach any necessary documents.
                </li>
                <li>
                    <strong>Q: What types of documents can I upload?</strong><br />
                    A: You can upload PDF, DOCX, and XLSX files as supporting documents for your claims.
                </li>
                <li>
                    <strong>Q: How can I track my claim status?</strong><br />
                    A: After submitting your claim, you can track its status in the "My Claims" section of your account.
                </li>
                <li>
                    <strong>Q: Who can I contact for support?</strong><br />
                    A: For any support-related inquiries, please contact our support team via the Help page.
                </li>
                <li>
                    <strong>Q: What should I do if I encounter an error while submitting my claim?</strong><br />
                    A: If you experience any issues, please refresh the page and try again. If the problem persists, contact our support team.
                </li>
            </ul>
        </div>
    </div>
</body>
</html>
