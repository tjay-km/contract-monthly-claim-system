@{
    ViewData["Title"] = "Features - Contract Monthly Claim System";
    Layout = "_Layout";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin="" />
    <link rel="stylesheet"
          as="style"
          onload="this.rel='stylesheet'"
          href="https://fonts.googleapis.com/css2?display=swap&amp;family=Inter%3Awght%40400%3B500%3B700%3B900&amp;family=Noto+Sans%3Awght%40400%3B500%3B700%3B900" />
    <link rel="stylesheet" href="~/css/site.css" />
    <title>Features - Contract Monthly Claim System</title>
    <link rel="icon" type="image/x-icon" href="data:image/x-icon;base64," />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
</head>
<body class="bg-slate-50">
    <div class="flex justify-center items-center min-h-screen">
        <div class="bg-white shadow-md rounded-lg p-6 max-w-4xl w-full">
            <header class="mb-5">
                <h1 class="text-3xl font-bold text-center text-[#0e141b]">Features of Contract Monthly Claim System</h1>
            </header>
            <main>
                <h2 class="text-2xl font-semibold text-[#111418] mb-4">Unique Features</h2>

                <ul class="list-disc list-inside space-y-2">
                    <li>
                        <strong>Streamlined Claim Submission:</strong> The CMCS allows independent contractor lecturers to submit their monthly claims easily and efficiently. The user-friendly interface guides users through the process step-by-step, ensuring clarity and ease of use.
                    </li>
                    <li>
                        <strong>Real-Time Claim Tracking:</strong> Users can track the status of their claims in real-time, providing transparency and reducing anxiety regarding the approval process.
                    </li>
                    <li>
                        <strong>Complex Calculations:</strong> The system automates complex calculations based on hours worked and hourly rates, minimizing errors and ensuring accurate payouts for lecturers.
                    </li>
                    <li>
                        <strong>Document Upload Capability:</strong> Users can upload essential supporting documents directly through the system, enhancing the efficiency of the claim process and ensuring all necessary documentation is in one place.
                    </li>
                    <li>
                        <strong>User Roles and Permissions:</strong> The CMCS has a built-in role management system, allowing different levels of access for Programme Coordinators and Academic Managers to review and approve claims, promoting accountability.
                    </li>
                    <li>
                        <strong>Error Reduction:</strong> By automating processes and providing a structured environment, the CMCS aims to mitigate potential errors that often occur in manual claim submissions.
                    </li>
                    <li>
                        <strong>Intuitive User Experience:</strong> The system is designed with user experience in mind, incorporating feedback mechanisms and an intuitive interface that makes navigation seamless for all users.
                    </li>
                </ul>
            </main>
    </div>
</body>
</html>
