@{
    ViewData["Title"] = "Features - Contract Monthly Claim System";
    Layout = "_Layout";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin="" />
    <link rel="stylesheet"
          as="style"
          onload="this.rel='stylesheet'"
          href="https://fonts.googleapis.com/css2?display=swap&amp;family=Inter%3Awght%40400%3B500%3B700%3B900&amp;family=Noto+Sans%3Awght%40400%3B500%3B700%3B900" />
    <link rel="stylesheet" href="~/css/site.css" />
    <title>Features - Contract Monthly Claim System</title>
    <link rel="icon" type="image/x-icon" href="data:image/x-icon;base64," />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
</head>
<body class="bg-slate-50">
    <div class="flex justify-center items-center min-h-screen">
        <div class="bg-white shadow-md rounded-lg p-6 max-w-4xl w-full">
            <header class="mb-5">
                <h1 class="text-3xl font-bold text-center text-[#0e141b]">Features of Contract Monthly Claim System</h1>
            </header>
            <main>
                <h2 class="text-2xl font-semibold text-[#111418] mb-4">System Features</h2>
                <div class="space-y-6">
                    <ul class="list-disc list-inside space-y-3">
                        <li>
                            <strong>Smart Claim Submission:</strong> Intuitive form with automatic calculations and instant validations for accurate claim processing
                        </li>
                        <li>
                            <strong>Document Management:</strong> Secure upload and storage of supporting documents with each claim
                        </li>
                        <li>
                            <strong>Real-Time Tracking:</strong> Monitor claim status throughout the entire approval process
                        </li>
                        <li>
                            <strong>Role-Based Access:</strong> Dedicated interfaces for lecturers, coordinators, and managers
                        </li>
                        <li>
                            <strong>Multi-Level Approval:</strong> Structured review process ensuring proper validation of all claims
                        </li>
                        <li>
                            <strong>Automated Calculations:</strong> Precise computation of claim amounts based on hours and rates
                        </li>
                        <li>
                            <strong>Comprehensive Validation:</strong> Built-in error checking and data verification at every step
                        </li>
                        <li>
                            <strong>User-Friendly Interface:</strong> Clean, responsive design optimized for all devices
                        </li>
                        <li>
                            <strong>Secure Authentication:</strong> Protected access with user verification and role management
                        </li>
                        <li>
                            <strong>Complete History:</strong> Access to historical claims and their status for better tracking
                        </li>
                    </ul>
                </div>
            </main>
    </div>
</body>
</html>
